{
  // === File Encoding & Line Endings ===
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.autoSave": "onFocusChange",

  // === Editor General Settings ===
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.renderWhitespace": "boundary",
  "editor.rulers": [80, 100, 120],
  "editor.wordWrap": "on",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.fixAll.clippy": "explicit",
    "source.organizeImports": "explicit"
  },

  // === Language-Specific Settings ===
  "[rust]": {
    "editor.tabSize": 4,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.semanticHighlighting.enabled": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.rust": "explicit",
      "source.organizeImports.rust": "explicit"
    }
  },
  "[toml]": {
    "editor.tabSize": 2,
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.tabSize": 2,
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    },
    "rust-analyzer.enable": false,
    "editor.semanticHighlighting.enabled": false,
    "editor.suggest.showWords": false,
    "editor.wordBasedSuggestions": "off"
  },
  "[json]": {
    "editor.tabSize": 2,
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.tabSize": 2,
    "editor.formatOnSave": true
  },
  "[powershell]": {
    "editor.tabSize": 4
  },
  "[yaml]": {
    "editor.tabSize": 2
  },

  // === Rust-Analyzer Settings ===
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.allTargets": true,
  "rust-analyzer.diagnostics.enable": true,
  "rust-analyzer.completion.autoimport.enable": true,
  "rust-analyzer.inlayHints.typeHints.enable": true,
  "rust-analyzer.inlayHints.parameterHints.enable": true,
  "rust-analyzer.inlayHints.chainingHints.enable": true,
  "rust-analyzer.lens.enable": true,
  "rust-analyzer.lens.methodReferences": true,
  "rust-analyzer.lens.references": true,
  "rust-analyzer.lens.run": true,
  "rust-analyzer.lens.debug": true,
  "rust-analyzer.runnables.command": "cargo",
  "rust-analyzer.files.excludeDirs": [],
  "rust-analyzer.files.excludeFiles": ["**/*.md"],
  "rust-analyzer.diagnostics.disabled": [
    "unresolved-import",
    "unresolved-macro-call",
    "undefined",
    "unknown-tool",
    "unknown-toolset"
  ],
  "rust-analyzer.workspace.symbol.search.scope": "workspace_and_dependencies",
  "rust-analyzer.workspace.symbol.search.kind": "only_types",
  "rust-analyzer.completion.callable.snippets": "none",
  "rust-analyzer.lens.forceCustomCommands": false,
  "rust-analyzer.rustfmt.extraArgs": [],
  "rust-analyzer.rustfmt.overrideCommand": null,

  // === Search & Explorer ===
  "search.exclude": {
    "**/target": true,
    "**/node_modules": true,
    "**/.git": true,
    "**/book": true,
    "**/docs": true
  },
  "files.exclude": {
    "**/target": true,
    "**/.git": true,
    "**/Cargo.lock": false
  },
  "files.watcherExclude": {
    "**/target/**": true
  },

  // === Terminal Settings ===
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.scrollback": 10000,

  // === Git Settings ===
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,

  // === File Organization & Test Management ===
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": true,
  "explorer.fileNesting.patterns": {
    // "*.rs": "${basename}_tests.rs,${basename}_extensions.rs,${basename}_collision.rs,${basename}_intersection.rs,${basename}_metrics.rs,${basename}_transform.rs,${basename}_sampling.rs,${basename}_containment.rs,${basename}_foundation.rs,${basename}_additional_tests.rs,${basename}_builder_tests.rs", // 無効化：具体的なパターンを優先
    // geo_core: Point/Vector は geo_core 側実装を正本とし、実在ファイルのみをネスト対象とする
    "point_2d.rs": "point_2d_tests.rs,point_2d_transform.rs",
    "point_3d.rs": "point_3d_tests.rs,point_3d_transform.rs",
    "vector_2d.rs": "vector_2d_tests.rs,vector_2d_transform.rs",
    "vector_3d.rs": "vector_3d_tests.rs,vector_3d_transform.rs",
    // geo_primitives（Issue #691）: 実在ファイルのみをネスト対象とする
    // foundation / constructs は固定接尾辞として前提化せず、実在する場合のみ個別エントリへ追加する
    "arc_2d.rs": "arc_2d_bounds.rs,arc_2d_containment.rs,arc_2d_extensions.rs,arc_2d_sampling.rs,arc_2d_tests.rs,arc_2d_transform.rs",
    "arc_3d.rs": "arc_3d_bounds.rs,arc_3d_extensions.rs,arc_3d_tests.rs,arc_3d_transform.rs",
    "circle_2d.rs": "circle_2d_bounds.rs,circle_2d_extensions.rs,circle_2d_metrics.rs,circle_2d_tests.rs,circle_2d_transform.rs",
    "circle_3d.rs": "circle_3d_bounds.rs,circle_3d_extensions.rs,circle_3d_tests.rs,circle_3d_transform.rs",
    "conical_solid_3d.rs": "conical_solid_3d_bounds.rs,conical_solid_3d_extensions.rs,conical_solid_3d_transform.rs",
    "conical_surface_3d.rs": "conical_surface_3d_bounds.rs,conical_surface_3d_extensions.rs,conical_surface_3d_transform.rs",
    "cylindrical_solid_3d.rs": "cylindrical_solid_3d_bounds.rs,cylindrical_solid_3d_extensions.rs,cylindrical_solid_3d_tests.rs,cylindrical_solid_3d_transform.rs",
    "cylindrical_surface_3d.rs": "cylindrical_surface_3d_bounds.rs,cylindrical_surface_3d_extensions.rs,cylindrical_surface_3d_tests.rs,cylindrical_surface_3d_transform.rs",
    "direction_2d.rs": "direction_2d_extensions_tests.rs,direction_2d_extensions.rs,direction_2d_transform.rs",
    "direction_3d.rs": "direction_3d_extensions_tests.rs,direction_3d_extensions.rs,direction_3d_transform.rs",
    "ellipse_2d.rs": "ellipse_2d_additional_tests.rs,ellipse_2d_bounds.rs,ellipse_2d_extensions.rs,ellipse_2d_tests.rs,ellipse_2d_transform.rs",
    "ellipse_3d.rs": "ellipse_3d_bounds.rs,ellipse_3d_extensions.rs,ellipse_3d_tests.rs,ellipse_3d_transform.rs",
    "ellipse_arc_2d.rs": "ellipse_arc_2d_bounds.rs,ellipse_arc_2d_extensions.rs,ellipse_arc_2d_transform.rs",
    "ellipse_arc_3d.rs": "ellipse_arc_3d_bounds.rs,ellipse_arc_3d_extensions.rs,ellipse_arc_3d_tests.rs,ellipse_arc_3d_transform.rs",
    "ellipsoidal_solid_3d.rs": "ellipsoidal_solid_3d_bounds.rs,ellipsoidal_solid_3d_transform.rs",
    "ellipsoidal_surface_3d.rs": "ellipsoidal_surface_3d_bounds.rs,ellipsoidal_surface_3d_extensions.rs,ellipsoidal_surface_3d_transform.rs",
    "infinite_line_2d.rs": "infinite_line_2d_extensions.rs,infinite_line_2d_transform.rs",
    "infinite_line_3d.rs": "infinite_line_3d_extensions.rs,infinite_line_3d_tests.rs,infinite_line_3d_transform.rs",
    "line_segment_2d.rs": "line_segment_2d_bounds.rs,line_segment_2d_extensions.rs,line_segment_2d_tests.rs,line_segment_2d_transform.rs",
    "line_segment_3d.rs": "line_segment_3d_bounds.rs,line_segment_3d_extensions.rs,line_segment_3d_tests.rs,line_segment_3d_transform.rs",
    "plane_3d.rs": "plane_3d_extensions.rs,plane_3d_tests.rs,plane_3d_transform.rs",
    "ray_2d.rs": "ray_2d_extensions.rs,ray_2d_transform.rs",
    "ray_3d.rs": "ray_3d_extensions.rs,ray_3d_tests.rs,ray_3d_transform.rs",
    "rectangle_2d.rs": "rectangle_2d_bounds.rs,rectangle_2d_transform.rs",
    "rectangle_3d.rs": "rectangle_3d_bounds.rs,rectangle_3d_transform.rs",
    "spherical_solid_3d.rs": "spherical_solid_3d_bounds.rs,spherical_solid_3d_tests.rs,spherical_solid_3d_transform.rs",
    "spherical_surface_3d.rs": "spherical_surface_3d_bounds.rs,spherical_surface_3d_transform.rs",
    "torus_solid_3d.rs": "torus_solid_3d_bounds.rs,torus_solid_3d_extensions.rs,torus_solid_3d_transform.rs",
    "torus_surface_3d.rs": "torus_surface_3d_bounds.rs,torus_surface_3d_extensions.rs,torus_surface_3d_transform.rs",
    "triangle_2d.rs": "triangle_2d_bounds.rs,triangle_2d_transform.rs",
    "triangle_3d.rs": "triangle_3d_bounds.rs,triangle_3d_tests.rs,triangle_3d_transform.rs",
    "triangle_mesh_3d.rs": "triangle_mesh_3d_bounds.rs,triangle_mesh_3d_tests.rs,triangle_mesh_3d_transform.rs",
    // geo_nurbs ファイルネスティング
    "curve_2d.rs": "curve_2d_bounds.rs,curve_2d_transform.rs",
    "curve_3d.rs": "curve_3d_bounds.rs,curve_3d_extensions.rs,curve_3d_transform.rs",
    "surface_3d.rs": "surface_3d_bounds.rs,surface_3d_extensions.rs,surface_3d_transform.rs",
    // foundation/analysis クレート
    "consts.rs": "consts_tests.rs",
    "units.rs": "units_tests.rs",
    "scalar.rs": "scalar_tests.rs",
    "plane3.rs": "plane3_tests.rs",
    "integration.rs": "integration_tests.rs",
    "partition.rs": "partition_tests.rs",
    "vector_distance.rs": "vector_distance_tests.rs",
    "point2.rs": "point2_tests.rs",
    "point3.rs": "point3_tests.rs",
    "quaternion.rs": "quaternion_tests.rs",
    "matrix2.rs": "matrix2_tests.rs",
    "matrix3.rs": "matrix3_tests.rs",
    "matrix4.rs": "matrix4_tests.rs",
    "dynamic_matrix.rs": "dynamic_matrix_tests.rs",
    "vector.rs": "vector_tests.rs",
    "vector2.rs": "vector2_tests.rs",
    "vector3.rs": "vector3_tests.rs",
    "vector4.rs": "vector4_tests.rs",
    "cramer.rs": "cramer_tests.rs",
    "gaussian.rs": "gaussian_tests.rs",
    "lu.rs": "lu_tests.rs",
    "newton.rs": "newton_tests.rs",
    "mod.rs": "mod_tests.rs",
    "angle.rs": "angle_tests.rs",
    // cam_core クレート
    "machine_constraint.rs": "machine_constraint_tests.rs",
    "tool.rs": "tool_tests.rs",
    "toolpath.rs": "toolpath_tests.rs",
    "toolset.rs": "toolset_tests.rs",
    // その他
    "transform.rs": "transform_error.rs",
    "collision.rs": "collision_error.rs",
    "intersection.rs": "intersection_error.rs",
    "Cargo.toml": "Cargo.lock",
    "README.md": "*.md,MIGRATION_*.md,*-analysis.md,*-plan.md,*-roadmap.md,*-report.md,UNITS.md,ARCHITECTURE_DESIGN_PLAN.md,CIRCLE_IMPROVEMENT_PROPOSAL.md,CORE_EXTENSION_FOUNDATION_PATTERN.md",
    "LICENSE": "LICENSE-MIT,LICENSE-APACHE",
    "book.toml": "book,docs"
  },
  "explorer.sortOrder": "type",
  "explorer.compactFolders": false,
  "explorer.decorations.colors": true,
  "explorer.decorations.badges": true,

    "workbench.colorCustomizations": {
    "editorIndentGuide.background1": "#ff000098",
    "editorIndentGuide.background2": "#00ff0076",
    "editorIndentGuide.background3": "#0000ff94",
    "editorIndentGuide.background4": "#ff00ff9f",
    "editorIndentGuide.background5": "#00ffff9b",
    "editorIndentGuide.background6": "#ffff0097",
    "editorIndentGuide.activeBackground1": "#CCC",
    "editorIndentGuide.activeBackground2": "#CCC",
    "editorIndentGuide.activeBackground3": "#CCC",
    "editorIndentGuide.activeBackground4": "#CCC",
    "editorIndentGuide.activeBackground5": "#CCC",
    "editorIndentGuide.activeBackground6": "#CCC"
  },

  // === Workspace-Specific Settings ===
  "workbench.colorTheme": "PowerShell ISE",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.tree.indent": 12,
  "workbench.tree.renderIndentGuides": "always",
  "breadcrumbs.enabled": true,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,

  // === Language Server Settings ===
  "rust-analyzer.server.extraEnv": {
    "RUST_ANALYZER_DISABLE_MARKDOWN": "1"
  },
  "rust-analyzer.cargo.features": [],
  "rust-analyzer.linkedProjects": [],

  // === File Associations ===
  "files.associations": {
    "*.md": "markdown",
    "copilot-instructions.md": "markdown",
    "*_transform_safe.rs": "rust",
    "*_transform_safe_tests.rs": "rust",
    "*_extensions.rs": "rust",
    "*_foundation.rs": "rust",
    "*_tests.rs": "rust"
  },

  // === Performance Settings ===
  "typescript.preferences.includePackageJsonAutoImports": "off",
  "extensions.ignoreRecommendations": false,

  // === Testing & Development ===
  "rust-analyzer.cargo.buildScripts.enable": true,
  "rust-analyzer.procMacro.enable": true,
  "rust-analyzer.cargo.loadOutDirsFromCheck": true,
  "rust-analyzer.experimental.procAttrMacros": true,

  // === Documentation ===
  "rust-analyzer.hover.documentation.enable": true,
  "rust-analyzer.hover.actions.enable": true,
  "rust-analyzer.hover.actions.implementations.enable": true,
  "rust-analyzer.hover.actions.references.enable": true,

  // === Debugging ===
  "debug.allowBreakpointsEverywhere": true,
  "debug.showInStatusBar": "onFirstSessionStart",
  "chat.tools.terminal.autoApprove": {
    "/^git -C \"c:\\\\Users\\\\takat\\\\GitHub\\\\RedRing\" rev-parse HEAD$/": {
      "approve": true,
      "matchCommandLine": true
    }
  }
}
